# Laptop side only — used by tools/pull.mjs to fetch and decrypt the archive.
# Copy to .env and fill in. .env is gitignored and must never be committed.
# The phone does NOT read this file; it keeps its own copies in browser storage.

DT_OWNER=your-github-username

# Fine-grained personal access token.
# Repository access: only daytracker-data.  Permissions: Contents = Read-only.
# The laptop never writes — the phone is the sole writer.
DT_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# The same passphrase set in the app. Written on paper somewhere physical.
DT_PASSPHRASE=

# Optional. Defaults to C:\Home\Finance\daytracker
# DT_OUT=C:\Home\Finance\daytracker
